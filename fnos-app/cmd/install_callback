#!/bin/bash
# 应用安装完成后：导入内置的 MaaYYs Docker 镜像（离线，无需联网）
# 镜像以 gzip 压缩形式放在 app/maayys-image.tar.gz
#
# 判断「要不要导入」用的必须是**镜像指纹**，不能是「同名镜像在不在」：
# 只看名字的话，升级包里明明换了镜像也会被判定成「已存在」而跳过导入，
# 装完之后跑的其实还是旧镜像，而且全程没有任何报错。

LOG_FILE="${TRIM_PKGVAR}/install.log"
IMAGE="maayys-fnos:local"
TAR_GZ="${TRIM_APPDEST}/maayys-image.tar.gz"
TMP_TAR="${TRIM_PKGVAR}/maayys-image.tar"
ID_FILE="${TRIM_APPDEST}/maayys-image.id"

log_msg() {
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

write_user_error() {
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
    log_msg "ERROR: $1"
}

id_matches() {
    local current want
    current="$(printf '%s' "$1" | tr -d '[:space:]')"
    [ -n "${current}" ] || return 1
    [ -s "${ID_FILE}" ] || return 1
    while IFS= read -r want; do
        want="$(printf '%s' "${want}" | tr -d '[:space:]')"
        [ -n "${want}" ] || continue
        if [ "${current}" = "${want}" ] || [ "${current#sha256:}" = "${want#sha256:}" ]; then
            return 0
        fi
    done < "${ID_FILE}"
    return 1
}

# 回收升级前的旧镜像：load 之后 tag 已被新镜像接管，旧镜像只剩悬挂 ID。
# 容器还在跑时 rmi 对它无效（只能摘 tag、删不掉，返回非 0），所以这里只在
# 「没有任何容器引用」时删；删不掉就留给 cmd/main 在容器重建之后回收。
gc_unused_image() {
    local id refs
    id="$(printf '%s' "$1" | tr -d '[:space:]')"
    [ -n "${id}" ] || return 0
    if id_matches "${id}"; then
        return 0
    fi
    # 可能已被前面的 docker rmi -f 顺手删掉了：直接返回，别再去撞一次必然失败的 rmi 记 WARN。
    if ! docker image inspect "${id}" >/dev/null 2>&1; then
        return 0
    fi
    refs="$(docker ps -aq --filter "ancestor=${id}" 2>/dev/null)"
    if [ -n "${refs}" ]; then
        log_msg "旧镜像 ${id} 仍被容器引用，保留（容器重建后由 cmd/main 回收）。"
        return 0
    fi
    if docker rmi "${id}" >> "${LOG_FILE}" 2>&1; then
        log_msg "已回收旧镜像 ${id}。"
    else
        log_msg "WARN: 回收旧镜像 ${id} 失败，跳过。"
    fi
}

log_msg "install_callback started. APPDEST=${TRIM_APPDEST}"

if ! command -v docker >/dev/null 2>&1; then
    write_user_error "未找到 docker，请先在应用中心安装 Docker。"
    exit 0
fi

if [ ! -f "${TAR_GZ}" ]; then
    write_user_error "离线镜像包不存在：${TAR_GZ}"
    exit 0
fi

# 期望指纹取自包内镜像包本身，且与运行时同一套推导逻辑
log_msg "Reading image id(s) from ${TAR_GZ} ..."
EXPECT_IDS="$(bash "$(dirname "${BASH_SOURCE[0]}")/main" image-ids 2>>"${LOG_FILE}")" || EXPECT_IDS=""
if [ -z "${EXPECT_IDS}" ]; then
    write_user_error "无法从 ${TAR_GZ} 解析镜像信息，请查看日志 ${LOG_FILE}"
    exit 0
fi
printf '%s\n' "${EXPECT_IDS}" > "${ID_FILE}" 2>/dev/null || true
log_msg "Expected image id(s): $(printf '%s' "${EXPECT_IDS}" | tr '\n' ' ')"

CUR_ID="$(docker image inspect --format '{{.Id}}' "${IMAGE}" 2>/dev/null | tr -d '[:space:]')"
if [ -n "${CUR_ID}" ] && id_matches "${CUR_ID}"; then
    log_msg "Image already loaded and id matches, skip load."
    exit 0
fi

if [ -n "${CUR_ID}" ]; then
    log_msg "Image id mismatch (have=${CUR_ID}) -> removing stale image before load."
    docker rmi -f "${IMAGE}" >> "${LOG_FILE}" 2>&1 || true
fi

load_image() {
    # build.sh 产出的是 `docker save | gzip`，docker load 能直接读 gzip 流，
    # 不必先解出 1.3GB 的临时 tar（安装峰值磁盘因此少占 1.3GB）。
    if docker load -i "${TAR_GZ}" >> "${LOG_FILE}" 2>&1; then
        return 0
    fi

    # 兜底：个别老 daemon 不认压缩流。gunzip 对「流完好、尾部多几个字节」返回 2，
    # 但产物可用 —— 校验 tar -tf，不看返回码。
    log_msg "Direct load failed, retrying after decompressing to ${TMP_TAR} ..."
    gunzip -c "${TAR_GZ}" > "${TMP_TAR}" 2>> "${LOG_FILE}" || true
    if [ ! -s "${TMP_TAR}" ] || ! tar -tf "${TMP_TAR}" manifest.json >/dev/null 2>&1; then
        rm -f "${TMP_TAR}"
        return 1
    fi
    if docker load -i "${TMP_TAR}" >> "${LOG_FILE}" 2>&1; then
        rm -f "${TMP_TAR}"
        return 0
    fi
    rm -f "${TMP_TAR}"
    return 1
}

log_msg "Loading image (可能几分钟) ..."
if load_image; then
    log_msg "Image loaded successfully."
    AFTER_ID="$(docker image inspect --format '{{.Id}}' "${IMAGE}" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "${AFTER_ID}" ] && id_matches "${AFTER_ID}"; then
        log_msg "Verified: loaded image id matches expected."
    else
        log_msg "WARN: loaded image id ${AFTER_ID} does not match expected $(printf '%s' "${EXPECT_IDS}" | tr '\n' ' ')."
    fi
    gc_unused_image "${CUR_ID}"
else
    write_user_error "镜像导入失败，请查看日志 ${LOG_FILE}"
fi

exit 0
